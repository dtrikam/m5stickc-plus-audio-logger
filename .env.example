# ==============================================================================
# M5StickC Plus Audio Logger - Cloud Brain Configuration
# Copy to `.env` (never commit `.env` to version control).
# ==============================================================================

# HTTP server bind settings
PORT=8765
HOST=0.0.0.0

# Gemini API key for audio transcription & summarization
# Obtain at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Device authentication token (generate e.g. `openssl rand -hex 24`)
# Provision the same token on your M5StickC Plus via Web Portal or USB serial.
DEVICE_TOKEN=replace_with_long_random_token

# Optional HTTP Basic Auth protecting the web dashboard & API endpoints
# Leave blank to serve the dashboard without browser Basic Auth.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Email configuration for daily briefings & "Send Summary Email" button
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=your_smtp_app_password
RECIPIENT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Local timezone used for day boundaries & summary timestamps (IANA name)
TIMEZONE=UTC

# ==============================================================================
# Optional local CLI sync helper (`sync_logs.py`) settings
# ==============================================================================
M5_VM_URL=http://your-cloud-server-ip:8765
# M5_GCLOUD_HOST=your-vm-name
# M5_GCLOUD_ZONE=us-central1-a
# M5_GCLOUD_PROJECT=your-gcp-project
# M5_REMOTE_DB_PATH=/path/to/audio_brain/memory.db
